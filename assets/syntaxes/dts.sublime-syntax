%YAML 1.2
---
# Device Tree source, transcribed from highlight.js 11.11.1's `dts`
# grammar so it colours what marp colours. Scopes follow the bundled
# GitHub theme: title -> entity.name.class, attr/meta/number/operator/
# variable -> blue constants, string, comment.
name: Device Tree
scope: source.dts
file_extensions: []
contexts:
  main:
    - match: '^/(?=\s*\{)'
      scope: entity.name.class.dts
    - match: '&[a-z\d_]*\b'
      scope: constant.other.reference.dts
    - match: '/[a-z][a-z\d-]*/'
      scope: keyword.other.dts
    - match: '^\s*[a-zA-Z_][a-zA-Z\d_]*:'
      scope: constant.other.symbol.dts
    - match: '[a-zA-Z_][a-zA-Z\d_@-]*(?=\s\{)'
      scope: entity.name.class.dts
    - match: '([a-z][a-z\-,]+)\s*(=)'
      captures:
        1: entity.other.attribute-name.dts
        2: keyword.operator.dts
    - match: '[a-z][a-z\-,]+(?=;)'
      scope: entity.other.attribute-name.dts
    - match: '<'
      push: cells
    - include: comments
    - include: numbers
    - include: strings
    - match: '#'
      push: preprocessor
  cells:
    - match: '>'
      pop: true
    - include: numbers
    - match: '&[a-z\d_]*\b'
      scope: constant.other.reference.dts
  comments:
    - match: '//.*$'
      scope: comment.line.dts
    - match: '/\*'
      push:
        - meta_scope: comment.block.dts
        - match: '\*/'
          pop: true
  numbers:
    - match: '\b(\d+(\.\d*)?|\.\d+)(u|U|l|L|ul|UL|f|F)'
      scope: constant.numeric.dts
    - match: '(-?)(\b0[xX][a-fA-F0-9]+|(\b\d+(\.\d*)?|\.\d+)([eE][-+]?\d+)?)'
      scope: constant.numeric.dts
  strings:
    - match: '((u8?|U)|L)?"'
      push:
        - meta_scope: string.quoted.double.dts
        - match: '\\.'
        - match: '"'
          pop: true
  preprocessor:
    - meta_scope: constant.other.preprocessor.dts
    - match: '$'
      pop: true
    - match: '\b(include)\b'
      scope: keyword.other.dts
    - match: '\b(if|else|elif|endif|define|undef|ifdef|ifndef)\b'
      scope: keyword.other.dts
    - match: '<[^>\n]*>'
      scope: string.quoted.other.dts
    - include: strings
    - include: comments
