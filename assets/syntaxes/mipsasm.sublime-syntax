%YAML 1.2
---
# MIPS assembly, transcribed from highlight.js 11.11.1's `mipsasm` grammar
# (alias `mips`) so it colours what marp colours: instructions as
# keywords, directives as meta (blue), registers as built-ins and labels
# as symbols (orange). Pseudo-instructions such as `li` and `la` are not
# in highlight.js's list, so they stay plain there and here.
name: MIPS Assembly
scope: source.mipsasm
file_extensions: []
contexts:
  main:
    - match: '(?i)\b(addi?u?|andi?|b(al)?|beql?|bgez(al)?l?|bgtzl?|blezl?|bltz(al)?l?|bnel?|cl[oz]|divu?|ext|ins|j(al)?|jalr(\.hb)?|jr(\.hb)?|lbu?|lhu?|ll|lui|lw[lr]?|maddu?|mfhi|mflo|movn|movz|move|msubu?|mthi|mtlo|mul|multu?|nop|nor|ori?|rotrv?|sb|sc|se[bh]|sh|sllv?|slti?u?|srav?|srlv?|subu?|sw[lr]?|xori?|wsbh|abs\.[sd]|add\.[sd]|alnv.ps|bc1[ft]l?|c\.(s?f|un|u?eq|[ou]lt|[ou]le|ngle?|seq|l[et]|ng[et])\.[sd]|(ceil|floor|round|trunc)\.[lw]\.[sd]|cfc1|cvt\.d\.[lsw]|cvt\.l\.[dsw]|cvt\.ps\.s|cvt\.s\.[dlw]|cvt\.s\.p[lu]|cvt\.w\.[dls]|div\.[ds]|ldx?c1|luxc1|lwx?c1|madd\.[sd]|mfc1|mov[fntz]?\.[ds]|msub\.[sd]|mth?c1|mul\.[ds]|neg\.[ds]|nmadd\.[ds]|nmsub\.[ds]|p[lu][lu]\.ps|recip\.fmt|r?sqrt\.[ds]|sdx?c1|sub\.[ds]|suxc1|swx?c1|break|cache|d?eret|[de]i|ehb|mfc0|mtc0|pause|prefx?|rdhwr|rdpgpr|sdbbp|ssnop|synci?|syscall|teqi?|tgei?u?|tlb(p|r|w[ir])|tlti?u?|tnei?|wait|wrpgpr)(?=\s|$)'
      scope: keyword.other.mipsasm
    - match: '[;#](?!\s*$)'
      push:
        - meta_scope: comment.line.mipsasm
        - match: '$'
          pop: true
    - match: '/\*'
      push:
        - meta_scope: comment.block.mipsasm
        - match: '\*/'
          pop: true
    - match: '"'
      push:
        - meta_scope: string.quoted.double.mipsasm
        - match: '\\.'
        - match: '"'
          pop: true
    - match: '''.*?[^\\]'''
      scope: string.quoted.single.mipsasm
    - match: '\|[^|\n]*\|'
      scope: entity.name.class.mipsasm
    - match: '(?i)0x[0-9a-f]+|\b-?\d+'
      scope: constant.numeric.mipsasm
    - match: '(?i)^\s*[a-z_.$][a-z0-9_.$]+:|^\s*[0-9]+:|[0-9]+[bf]'
      scope: constant.other.symbol.mipsasm
    - match: '(?i)(?<![\w.])\.(2byte|4byte|align|ascii|asciz|balign|byte|code|data|else|end|endif|endm|endr|equ|err|exitm|extern|global|hword|if|ifdef|ifndef|include|irp|long|macro|rept|req|section|set|skip|space|text|word|ltorg)\b'
      scope: constant.other.directive.mipsasm
    - match: '\$([0-9]|[12][0-9]|3[01])\b|\$f([0-9]|[12][0-9]|3[01])\b'
      scope: support.function.register.mipsasm
    - match: '(?i)\b(zero|at|v[01]|a[0-7]|t[0-9]|s[0-8]|k[01]|gp|sp|fp|ra)\b'
      scope: support.function.register.mipsasm
