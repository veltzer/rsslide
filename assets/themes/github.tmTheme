<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- GitHub light syntax colors as marp's default theme applies them to
     highlight.js classes (GitHub "prettylights" palette), mapped onto
     TextMate scopes for syntect. -->
<plist version="1.0">
<dict>
	<key>name</key>
	<string>GitHub</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>#f6f8fa</string>
				<key>foreground</key>
				<string>#1f2328</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Comment</string>
			<key>scope</key>
			<string>comment, punctuation.definition.comment</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#59636e</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Keyword</string>
			<key>scope</key>
			<string>keyword, storage, storage.type, storage.modifier, support.type, variable.language, keyword.control</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#cf222e</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Operator</string>
			<key>scope</key>
			<string>keyword.operator</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#0550ae</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Title</string>
			<key>scope</key>
			<string>entity.name.function, entity.name.class, entity.name.type, entity.other.inherited-class, entity.name.section</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#6639ba</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Constant</string>
			<key>scope</key>
			<string>constant, constant.numeric, constant.language, constant.character, constant.other, entity.other.attribute-name, support.constant, meta.preprocessor, variable.other.constant, variable.other.normal, variable.other.bracket, variable.other.special, variable.other.positional</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#0550ae</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>String</string>
			<key>scope</key>
			<string>string, string.regexp, punctuation.definition.string</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#0a3069</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Built-in</string>
			<key>scope</key>
			<string>support.function, support.class, constant.other.symbol</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#953800</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Tag</string>
			<key>scope</key>
			<string>entity.name.tag, markup.quote</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#0550ae</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Heading</string>
			<key>scope</key>
			<string>markup.heading</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#0550ae</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Inserted</string>
			<key>scope</key>
			<string>markup.inserted</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#116329</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Deleted</string>
			<key>scope</key>
			<string>markup.deleted</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#82071e</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
